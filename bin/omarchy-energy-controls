#!/bin/bash

# Part of Laptop Power Center. See ../THIRD_PARTY_NOTICES.md and ../LICENSE.

set -euo pipefail

usage() {
  echo "Usage: omarchy-energy-controls status --shell | {travel|quick-dim} {enable|disable}" >&2
  exit 2
}

action=${1:-}
value=${2:-}
test_mode=${OMARCHY_ENERGY_TEST_MODE:-0}

if [[ $test_mode == 1 ]]; then
  PATH=${OMARCHY_ENERGY_TEST_PATH:-/usr/share/omarchy/bin:/usr/bin:/bin}
  state_root=${OMARCHY_ENERGY_STATE_ROOT:?Test state root is required}
  nvidia_override=${OMARCHY_ENERGY_NVIDIA_PATH:-}
else
  PATH=/usr/share/omarchy/bin:/usr/bin:/bin
  state_root=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-laptop-power-center
  nvidia_override=""
fi

travel_state="$state_root/travel-state"
dim_state="$state_root/quick-dim-state"

ensure_state_dir() {
  mkdir -p "$state_root"
  chmod 0700 "$state_root"
}

write_state() {
  local destination=$1
  shift
  local temporary
  ensure_state_dir
  temporary=$(mktemp "$state_root/.state.XXXXXX")
  chmod 0600 "$temporary"
  while (( $# >= 2 )); do
    printf '%s\t%s\n' "$1" "$2" >>"$temporary"
    shift 2
  done
  mv -f -- "$temporary" "$destination"
}

read_state() {
  local source=$1 key=$2
  [[ -r $source ]] || return 1
  awk -F '\t' -v wanted="$key" '$1 == wanted { print $2; exit }' "$source"
}

focused_monitor() {
  omarchy-hyprland-monitor-focused 2>/dev/null || true
}

brightness_percent() {
  local monitor=${1:-} current
  if [[ -n $monitor ]]; then
    current=$(omarchy-brightness-display --monitor "$monitor" 2>/dev/null || true)
  else
    current=$(omarchy-brightness-display 2>/dev/null || true)
  fi
  [[ $current =~ ^[0-9]+$ ]] || { echo unsupported; return; }
  printf '%s\n' "$current"
}

set_brightness_percent() {
  local requested=$1 monitor=${2:-}
  [[ $requested =~ ^[0-9]+$ ]] || return 1
  (( requested >= 1 && requested <= 100 )) || return 1
  if [[ -n $monitor ]]; then
    omarchy-brightness-display --no-osd --monitor "$monitor" "${requested}%" >/dev/null
  else
    omarchy-brightness-display --no-osd "${requested}%" >/dev/null
  fi
}

profile_state() {
  powerprofilesctl get 2>/dev/null || echo unknown
}

set_profile() {
  case $1 in
    power-saver | balanced | performance) powerprofilesctl set "$1" ;;
    unknown | unsupported | "") return 0 ;;
    *) return 1 ;;
  esac
}

nvidia_power_state() {
  local device vendor
  if [[ -n $nvidia_override ]]; then
    device=$nvidia_override
  else
    device=""
    for vendor in /sys/bus/pci/devices/*/vendor; do
      [[ -r $vendor && $(<"$vendor") == 0x10de ]] || continue
      device=${vendor%/vendor}
      break
    done
  fi

  [[ -n $device ]] || { echo disabled; return; }
  [[ -r $device/power/runtime_status ]] || { echo unavailable; return; }
  case $(<"$device/power/runtime_status") in
    active) echo active ;;
    suspended | suspending) echo suspended ;;
    *) echo unavailable ;;
  esac
}

status_shell() {
  local travel quick_dim brightness
  [[ -r $travel_state ]] && travel=enabled || travel=disabled
  brightness=$(brightness_percent)
  if [[ ! $brightness =~ ^[0-9]+$ ]]; then
    quick_dim=unsupported
  elif [[ -r $dim_state || $travel == enabled ]]; then
    quick_dim=enabled
  else
    quick_dim=disabled
  fi

  printf 'travel\t%s\n' "$travel"
  printf 'quick_dim\t%s\n' "$quick_dim"
  printf 'brightness\t%s\n' "$brightness"
  printf 'nvidia_power\t%s\n' "$(nvidia_power_state)"
}

quick_dim_enable() {
  if [[ ! -r $dim_state ]]; then
    local previous monitor
    monitor=$(focused_monitor)
    previous=$(brightness_percent "$monitor")
    [[ $previous =~ ^[0-9]+$ ]] || { echo "Display brightness control is unavailable" >&2; return 1; }
    write_state "$dim_state" brightness "$previous" monitor "$monitor"
  fi
  set_brightness_percent 40 "$(read_state "$dim_state" monitor || true)"
}

quick_dim_disable() {
  [[ -r $dim_state ]] || return 0
  local previous monitor
  previous=$(read_state "$dim_state" brightness || true)
  monitor=$(read_state "$dim_state" monitor || true)
  set_brightness_percent "$previous" "$monitor"
  rm -f -- "$dim_state"
}

travel_enable() {
  if [[ ! -r $travel_state ]]; then
    local monitor
    monitor=$(focused_monitor)
    write_state "$travel_state" \
      profile "$(profile_state)" \
      brightness "$(brightness_percent "$monitor")" \
      monitor "$monitor"
  fi

  set_profile power-saver
  set_brightness_percent 40 "$(read_state "$travel_state" monitor || true)"
}

travel_disable() {
  [[ -r $travel_state ]] || return 0
  local profile brightness monitor
  profile=$(read_state "$travel_state" profile || true)
  brightness=$(read_state "$travel_state" brightness || true)
  monitor=$(read_state "$travel_state" monitor || true)

  set_profile "$profile"
  [[ $brightness =~ ^[0-9]+$ ]] && set_brightness_percent "$brightness" "$monitor"
  rm -f -- "$travel_state"
}

if [[ $action == status && $value == --shell && $# == 2 ]]; then
  status_shell
  exit 0
fi

(( $# == 2 )) || usage
[[ $value == enable || $value == disable ]] || usage
case $action in
  travel | quick-dim) ;;
  *) usage ;;
esac

case "$action:$value" in
  travel:enable) travel_enable ;;
  travel:disable) travel_disable ;;
  quick-dim:enable) quick_dim_enable ;;
  quick-dim:disable) quick_dim_disable ;;
esac
